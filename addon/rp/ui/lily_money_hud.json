  "notice_text@lily_money_hud.card_slot": {
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(((((((((($end * #hud_title_text_string) - ($after_phase * #hud_title_text_string)) - '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~') - '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~') - '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~') - '~~~~~~~~~~~~~~~~') - '~~~~~~~~') - '~~~~') - '~~') - '~')",
        "target_property_name": "#card_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(($after_phase * #hud_title_text_string) - ($start * #hud_title_text_string))",
        "target_property_name": "#card_phase"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - $route) = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  },
  "last_notice_text@lily_money_hud.card_slot": {
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(((((((((($end * #saved) - ($after_phase * #saved)) - '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~') - '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~') - '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~') - '~~~~~~~~~~~~~~~~') - '~~~~~~~~') - '~~~~') - '~~') - '~')",
        "target_property_name": "#card_text",
        "source_control_name": "balance_memory",
        "resolve_sibling_scope": true
      },
      {
        "binding_type": "view",
        "source_property_name": "(($after_phase * #saved) - ($start * #saved))",
        "target_property_name": "#card_phase",
        "source_control_name": "balance_memory",
        "resolve_sibling_scope": true
      },
      {
        "binding_type": "view",
        "source_property_name": "((not (not ((#hud_title_text_string - $route) = #hud_title_text_string))) and (not (#hud_title_text_string = '~LM3:R')))",
        "target_property_name": "#visible"
      }
    ]
  }
