        }
      },
      {
        "frame_F@lily_money_hud.card_frame": {
          "$label_name": "frame_F",
          "$phase": "F",
          "$opacity": 1,
          "$shift": "$shift_F"
        }
      },
      {
        "frame_G@lily_money_hud.card_frame": {
          "$label_name": "frame_G",
          "$phase": "G",
          "$opacity": 1,
          "$shift": "$shift_G"
        }
      },
      {
        "frame_H@lily_money_hud.card_frame": {
          "$label_name": "frame_H",
          "$phase": "H",
          "$opacity": 1,
          "$shift": "$shift_H"
        }
      },
      {
        "frame_I@lily_money_hud.card_frame": {
          "$label_name": "frame_I",
          "$phase": "I",
          "$opacity": 1,
          "$shift": "$shift_I"
        }
      },
      {
        "frame_J@lily_money_hud.card_frame": {
          "$label_name": "frame_J",
          "$phase": "J",
          "$opacity": 1,
          "$shift": "$shift_J"
        }
      },
      {
        "frame_K@lily_money_hud.card_frame": {
          "$label_name": "frame_K",
          "$phase": "K",
          "$opacity": 1,
          "$shift": "$shift_K"
        }
      },
      {
        "frame_L@lily_money_hud.card_frame": {
          "$label_name": "frame_L",
          "$phase": "L",
          "$opacity": 1,
          "$shift": "$shift_L"
        }
      }
