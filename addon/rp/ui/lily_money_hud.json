{
  "namespace": "lily_money_hud",
  "balance_memory": {
    "type": "panel",
    "size": [
      0,
      0
    ],
    "property_bag": {
      "#saved": ""
    },
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_name": "#hud_title_text_string",
        "binding_name_override": "#saved",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not (#hud_title_text_string = #saved)) and ((not ((#hud_title_text_string - $route) = #hud_title_text_string)) or (#hud_title_text_string = '~LM3:R')))",
        "target_property_name": "#visible"
      }
    ]
  },
  "wallet": {
    "type": "panel",
    "size": [
      "100%",
      96
    ],
    "controls": [
      {
        "balance_memory@lily_money_hud.balance_memory": {}
      },
      {
        "amount": {
          "type": "label",
          "text": "#text",
          "localize": false,
          "shadow": true,
          "font_scale_factor": 0.96,
          "text_alignment": "$align",
          "anchor_from": "$corner",
          "anchor_to": "$corner",
          "offset": [
            0,
            0
          ],
          "bindings": [
            {
              "binding_name": "#hud_title_text_string"
            },
            {
              "binding_type": "view",
              "source_property_name": "((((((('%.28s' * #hud_title_text_string) - $route) - '______________________') - '        ') - '    ') - '  ') - ' ')",
              "target_property_name": "#text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#hud_title_text_string - $route) = #hud_title_text_string))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "backdrop@lily_money_hud.text_backdrop": {
                "$label_name": "amount"
              }
            }
          ],
          "color": [
            1,
            1,
            1
          ]
        }
      },
      {
        "last_amount": {
          "type": "label",
          "text": "#text",
          "localize": false,
          "shadow": true,
          "font_scale_factor": 0.96,
          "text_alignment": "$align",
          "anchor_from": "$corner",
          "anchor_to": "$corner",
          "offset": [
            0,
            0
          ],
          "bindings": [
            {
              "binding_name": "#hud_title_text_string"
            },
            {
              "binding_type": "view",
              "source_property_name": "(((((((('%.28s' * #saved) - $route) - '~LM3:R') - '______________________') - '        ') - '    ') - '  ') - ' ')",
              "target_property_name": "#text",
              "source_control_name": "balance_memory",
              "resolve_sibling_scope": true
            },
            {
              "binding_type": "view",
              "source_property_name": "((not (not ((#hud_title_text_string - $route) = #hud_title_text_string))) and (not (#hud_title_text_string = '~LM3:R')))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "backdrop@lily_money_hud.text_backdrop": {
                "$label_name": "last_amount"
              }
            }
          ],
          "color": [
            1,
            1,
            1
          ]
        }
      },
      {
        "notice_text_1@lily_money_hud.notice_text": {
          "$position": "$row1",
          "$start": "%.29s",
          "$end": "%.285s",
          "$slot_name": "notice_text_1",
          "$after_phase": "%.30s"
        }
      },
      {
        "notice_text_2@lily_money_hud.notice_text": {
          "$position": "$row2",
          "$start": "%.286s",
          "$end": "%.542s",
          "$slot_name": "notice_text_2",
          "$after_phase": "%.287s"
        }
      },
      {
        "notice_text_3@lily_money_hud.notice_text": {
          "$position": "$row3",
          "$start": "%.543s",
          "$end": "%.799s",
          "$slot_name": "notice_text_3",
          "$after_phase": "%.544s"
        }
      },
      {
        "notice_text_4@lily_money_hud.notice_text": {
          "$position": "$row4",
          "$start": "%.800s",
          "$end": "%.1056s",
          "$slot_name": "notice_text_4",
          "$after_phase": "%.801s"
        }
      },
      {
        "notice_text_5@lily_money_hud.notice_text": {
          "$position": "$row5",
          "$start": "%.1057s",
          "$end": "%.1313s",
          "$slot_name": "notice_text_5",
          "$after_phase": "%.1058s"
        }
      },
      {
        "notice_text_6@lily_money_hud.notice_text": {
          "$position": "$row6",
          "$start": "%.1314s",
          "$end": "%.1570s",
          "$slot_name": "notice_text_6",
          "$after_phase": "%.1315s"
        }
      },
      {
        "last_notice_text_1@lily_money_hud.last_notice_text": {
          "$position": "$row1",
          "$start": "%.29s",
          "$end": "%.285s",
          "$slot_name": "last_notice_text_1",
          "$after_phase": "%.30s"
        }
      },
      {
        "last_notice_text_2@lily_money_hud.last_notice_text": {
          "$position": "$row2",
          "$start": "%.286s",
          "$end": "%.542s",
          "$slot_name": "last_notice_text_2",
          "$after_phase": "%.287s"
        }
      },
      {
        "last_notice_text_3@lily_money_hud.last_notice_text": {
          "$position": "$row3",
          "$start": "%.543s",
          "$end": "%.799s",
          "$slot_name": "last_notice_text_3",
          "$after_phase": "%.544s"
        }
      },
      {
        "last_notice_text_4@lily_money_hud.last_notice_text": {
          "$position": "$row4",
          "$start": "%.800s",
          "$end": "%.1056s",
          "$slot_name": "last_notice_text_4",
          "$after_phase": "%.801s"
        }
      },
      {
        "last_notice_text_5@lily_money_hud.last_notice_text": {
          "$position": "$row5",
          "$start": "%.1057s",
          "$end": "%.1313s",
          "$slot_name": "last_notice_text_5",
          "$after_phase": "%.1058s"
        }
      },
      {
        "last_notice_text_6@lily_money_hud.last_notice_text": {
          "$position": "$row6",
          "$start": "%.1314s",
          "$end": "%.1570s",
          "$slot_name": "last_notice_text_6",
          "$after_phase": "%.1315s"
        }
      }
    ],
    "anchor_from": "$corner",
    "anchor_to": "$corner",
    "offset": "$inset",
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_control_name": "route_memory",
        "resolve_sibling_scope": true,
        "source_property_name": "('%.6s' * #saved)",
        "target_property_name": "#last_route"
      },
      {
        "binding_type": "view",
        "source_property_name": "((('%.6s' * #hud_title_text_string) = $route) or (((#hud_title_text_string - '~LM3:') = #hud_title_text_string) and (#last_route = $route)))",
        "target_property_name": "#visible"
      }
    ],
    "property_bag": {
      "#last_route": ""
    }
  },
