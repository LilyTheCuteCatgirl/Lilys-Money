  "text_backdrop": {
    "type": "image",
    "texture": "textures/lily_hud/backdrop",
    "size": [
      "100% + 4px",
      "100% + 2px"
    ],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": -1,
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$label_name",
        "source_property_name": "(not (#text = ''))",
        "target_property_name": "#visible"
      }
    ]
  },
  "card_frame": {
    "type": "label",
    "text": "#text",
    "localize": false,
    "shadow": true,
    "font_scale_factor": 0.96,
    "text_alignment": "$align",
    "anchor_from": "$corner",
    "anchor_to": "$corner",
    "alpha": "$opacity",
    "propagate_alpha": true,
    "offset": "$shift",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$slot_name",
        "source_property_name": "#card_text",
        "target_property_name": "#text"
      },
      {
        "binding_type": "view",
        "source_control_name": "$slot_name",
        "source_property_name": "(#card_phase = $phase)",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "backdrop@lily_money_hud.text_backdrop": {}
      }
    ]
  },
  "card_slot": {
    "type": "panel",
    "size": [
      "100%",
      13
    ],
    "anchor_from": "$corner",
    "anchor_to": "$corner",
    "offset": "$position",
    "property_bag": {
      "#card_text": "",
      "#card_phase": ""
    },
    "controls": [
      {
        "frame_A@lily_money_hud.card_frame": {
          "$label_name": "frame_A",
          "$phase": "A",
          "$opacity": 0.08,
          "$shift": "$shift_A"
        }
      },
      {
        "frame_B@lily_money_hud.card_frame": {
          "$label_name": "frame_B",
          "$phase": "B",
          "$opacity": 0.28,
