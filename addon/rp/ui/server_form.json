
{
    "namespace": "server_form",
    "dynamic_button": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "replace",
                "where": {
                    "form_button@common_buttons.light_text_button": {
                        "$pressed_button_name": "button.form_button_click",
                        "anchor_from": "top_left",
                        "anchor_to": "top_left",
                        "size": ["fill", 32],
                        "$button_text": "#form_button_text",
                        "$button_text_binding_type": "collection",
                        "$button_text_grid_collection_name": "form_buttons",
                        "$button_text_max_size": ["100%", 20],
                        "bindings": [
                            {
                                "binding_type": "collection_details",
                                "binding_collection_name": "form_buttons"
                            }
                        ]
                    }
                },
                "value": {
                    "form_button@common_buttons.light_text_button_b": {
                        "$pressed_button_name": "button.form_button_click",
                        "anchor_from": "top_left",
                        "anchor_to": "top_left",
                        "size": ["fill", 32],
                        "$button_text": "#form_button_text",
                        "$button_text_binding_type": "collection",
                        "$button_text_grid_collection_name": "form_buttons",
                        "$button_text_max_size": ["100%", 20],
                        "bindings": [
                            {
                                "binding_type": "collection_details",
                                "binding_collection_name": "form_buttons"
                            }
                        ]
                    }
                }
            },
            {
                "array_name": "bindings",
                "operation": "insert_back",
                "value": [
                    {
                        "binding_name": "#form_button_text",
                        "binding_type": "collection",
                        "binding_collection_name": "form_buttons"
                    },
                    {
                      "binding_type": "view",
                      "source_property_name": "((('a' + #form_button_text) - $andexdb_disabled_button_code) = ('a' + #form_button_text))",
                      "target_property_name": "#enabled"
                    }
                ]
            }
        ]
    },

    "multiline_toggle@common.checkbox": {
        "toggle_name": "multiline_toggle",
        "toggle_grid_collection_name": "multiline_toggle",
        "anchor_from": "top_right",
        "anchor_to": "top_right"
    },

    "multiline_chat_enabled_toggle": {
        "type": "panel",
        "size": ["100%", "20px"],
        "controls": [
            {
                "title_panel": {
                    "type": "label",
                    "size": ["default", 10],
                    "text": "Multiline",
                    "offset": [2, -1],
                    "color": "$title_text_color",
                    "layer": 2
                }
            },
            {
                "toggle_panel": {
                    "type": "panel",
                    "size": ["100%c", "100%c"],
                    "anchor_from": "middle_right",
                    "anchor_to": "middle_right",
                    "controls": [
                        {
                            "multiline_toggle@server_form.multiline_toggle": {
                                "size": ["100%c", "100%c"],
                                "offset": [30, -1]
                            }
                        }
                    ]
                }
            }
        ]
    },

    "custom_input@settings_common.option_text_edit_c": {
        "$option_label": "#custom_text",
        "$option_place_holder_text": "#custom_placeholder_text",
        "$text_edit_box_placeholder_content_binding_name": "$option_place_holder_text",
        "$text_edit_box_placeholder_content_binding_type": "collection",
        "$text_edit_box_grid_collection_name": "custom_form",

        "$text_edit_box_content_binding_type": "collection",
        "$text_edit_box_content_binding_name": "#custom_input_text",

        "$option_binding_name": "#custom_input_text",
        "$text_box_enabled_binding_name": "#custom_input_enabled",
        "$text_box_name": "custom_input",
        "$label_bindings": [
            {
                "binding_name": "#custom_text",
                "binding_type": "collection",
                "binding_collection_name": "custom_form"
            }
        ],
        "variables": [
            {
                "requires": "$xbox_one",
                "$max_text_edit_length": 10000
            },
            {
                "requires": "(not $xbox_one)",
                "$max_text_edit_length": 100000000
            }
        ]
    },
    "long_form": {
        "modifications": [
            {
                "array_name": "bindings",
                "operation": "insert_front",
                "value": [
                    {
                        "binding_name": "#title_text"
                    },
                    {
                        "binding_type": "view",
                        "source_control_name": "long_form",
                        "source_property_name": "(('a' + #title_text) = ('a' + #title_text))",
                        "target_property_name": "#visible"
                    }
                ]
            },
            {
                "array_name": "bindings",
                "operation": "insert_back",
                "value": [
                    {
                        "binding_type": "view",
                        "source_control_name": "long_form",
                        "source_property_name": "(((('a' + #title_text) - $andexdb_general_form_code - $andexdb_general_status_bar_form_code - $andexdb_grid_menu_form_code - $andexdb_grid_menu_status_bar_form_code - $andexdb_wide_long_form_code - $andexdb_wide_status_bar_long_form_code - $andexdb_medium_long_form_code - $andexdb_medium_status_bar_long_form_code - $andexdb_fullscreen_long_form_code - $andexdb_fullscreen_status_bar_long_form_code) = ('a' + #title_text)) and #visible)",
                        "target_property_name": "#visible"
                    }
                ]
            }
        ]
    },
    "andexdb_long_form_panel": {
        "type": "panel",
        "bindings": [
            {
                "binding_name": "#title_text"
            }
        ],
        "controls": [
            {
                "general@andexdb_general_long_form.panel": {
                    "layer": 2,
                    "type": "panel",
                    "$show_status_bar": false,
                    "bindings": [
                        {
                            "binding_type": "global",
                            "binding_condition": "none",
                            "binding_name": "#title_text",
                            "binding_name_override": "#title_text"
                        },
                        {
                            "source_property_name": "((not ((('a' + #title_text) - $andexdb_grid_menu_form_code - $andexdb_general_form_code - $andexdb_wide_long_form_code - $andexdb_medium_long_form_code - $andexdb_fullscreen_long_form_code) = ('a' + #title_text)))",
                            "binding_type": "view",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            }
        ]
    },
    "custom_form": {
      "modifications": [
          {
              "array_name": "bindings",
              "operation": "insert_front",
              "value": [
                  {
                      "binding_name": "#title_text"
                  },
                  {
                      "binding_type": "view",
                      "source_control_name": "custom_form",
                      "source_property_name": "(('a' + #title_text) = ('a' + #title_text))",
                      "target_property_name": "#visible"
                  }
              ]
          },
          {
              "array_name": "bindings",
              "operation": "insert_back",
              "value": [
                  {
                      "binding_type": "view",
                      "source_control_name": "custom_form",
                      "source_property_name": "(((('a' + #title_text) - $andexdb_general_custom_form_code - $andexdb_wide_custom_form_code - $andexdb_medium_custom_form_code - $andexdb_fullscreen_custom_form_code) = ('a' + #title_text)) and #visible)",
                      "target_property_name": "#visible"
                  }
              ]
          }
      ]
    },
    "andexdb_custom_form_panel": {
        "type": "panel",
        "bindings": [
            {
                "binding_name": "#title_text"
            }
        ],
        "controls": [
            {
                "general_custom_menu_panel@andexdb_general_custom_form.panel": {
                    "bindings": [
                        {
                            "binding_name": "#title_text"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not ((('a' + #title_text) - $andexdb_general_custom_form_code - $andexdb_wide_custom_form_code - $andexdb_medium_custom_form_code - $andexdb_fullscreen_custom_form_code) = ('a' + #title_text)))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            }
        ]
    },
    "main_screen_content": {
        "size": ["100%", "100%"],
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "andexdb_server_form_factory": {
                            "type": "panel",
                            "factory": {
                                "name": "server_form_factory", 
                                "control_ids": {
                                    "long_form": "@server_form.andexdb_long_form_panel",
                                    "custom_form": "@server_form.andexdb_custom_form_panel"
                                }
                            }
                        }
                    }
                ]
            }
        ]
    }
}

